# Copy to .env.local (gitignored). `neon deploy` / `neon env pull` fill in the Neon-managed block for you:
# DATABASE_URL, DATABASE_URL_UNPOOLED, NEON_BRANCH, NEON_BRANCH_ID, NEON_FUNCTION_HOST_SUFFIX,
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT_URL_S3, AWS_REGION,
# NEON_AI_GATEWAY_TOKEN, NEON_AI_GATEWAY_BASE_URL, NEON_REALTIME_URL, NEON_REALTIME_SECRET
# (NEON_AUTH_* is pulled too but unused: login is self-hosted Better Auth.)

# App-side (public): Realtime WebSocket endpoint
EXPO_PUBLIC_NEON_REALTIME_URL=${NEON_REALTIME_URL}

# Better Auth: generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8081

# Google OAuth (Web application client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple: native iOS sign-in only, so this is just the bundle ID from app.json
APPLE_BUNDLE_ID=com.burakorkmez.restyle

# Resend: password reset emails. EMAIL_FROM needs a verified domain (default only sends to your own address)
RESEND_API_KEY=
EMAIL_FROM=
